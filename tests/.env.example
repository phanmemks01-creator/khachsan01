# Supabase → Settings → API Keys / Connect
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# Chỉ dùng nếu dự án Supabase cũ chưa có khóa sb_secret_.
# Không khai báo đồng thời nếu đã có SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Mã đăng nhập ứng dụng, tối thiểu 12 ký tự. Đặt chuỗi đủ dài và khó đoán trên Vercel.
APP_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY

# Không bắt buộc. Dùng để hiển thị tên môi trường trong /api/health.
APP_ENV=production
